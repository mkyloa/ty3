# Скопіюй у .env і встав потрібний ключ. Для дефолтного бекенда claude-cli ключ не потрібен.

# --backend anthropic — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --backend gemini — https://aistudio.google.com/apikey (потрібно: pip install -e ".[gemini]")
GEMINI_API_KEY=
